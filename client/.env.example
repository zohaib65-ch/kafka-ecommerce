# Base URL of the store API (the Express server in ../server). Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional. Socket.IO server used by the support chat. Defaults to the origin of NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Optional. Public URL of this site, used for absolute links in page metadata.
# NEXT_PUBLIC_SITE_URL=http://localhost:8080
